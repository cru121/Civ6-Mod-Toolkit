{
  "name": "civ6-mod-toolkit",
  "version": "2.0.0-dev",
  "private": true,
  "description": "Civilization VI mod toolkit: edit mods in .Civ6Cfg game configurations and see which mods are enabled.",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "phase0": "node src/phase0-roundtrip.js",
    "phase1": "node src/phase1-inventory.js",
    "phase2": "node src/phase2-save.js",
    "phase4": "node src/phase4-profiles.js",
    "phase5": "node src/phase5-labels.js",
    "phase6": "node src/phase6-sorting.js",
    "phase7": "node src/phase7-loadorder.js",
    "phase8": "node src/phase8-scripts.js",
    "phase9-replay": "node src/phase9-conflict-replay.js --envelope",
    "phase9-shadowing": "node src/phase9-shadowing.js --envelope",
    "phase10-packaging": "node src/phase10-packaging.js",
    "phase9-selfcheck": "node src/server.js --selfcheck",
    "phase-game-setup": "node src/phase-game-setup.js",
    "check:release": "npm run phase4 && npm run phase5 && npm run phase6 && npm run phase7 && npm run phase8 && npm run phase9-replay && npm run phase9-shadowing && npm run phase10-packaging && npm run phase9-selfcheck && npm run phase-game-setup",
    "edit": "node src/edit-config.js",
    "mods": "node src/mods-cli.js"
  },
  "author": "cru121 (Steam: evzenhouzvicka); contributions by Klear2012",
  "repository": "github:cru121/Civ6-Mod-Toolkit",
  "license": "MIT",
  "dependencies": {
    "buffer-v6-polyfill": "^1.0.5",
    "diacritics": "^1.3.0",
    "iconv-lite": "^0.6.3",
    "lodash": "^4.17.21",
    "minimist": "^1.2.8"
  }
}
